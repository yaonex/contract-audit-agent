# =====================================================================
# contract-audit-agent  (Python agent + Go server + Foundry sandbox)
# =====================================================================

# ---------------------------------------------------------------------
# Secrets & environment  (keep .env.example tracked)
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc

# ---------------------------------------------------------------------
# Python: bytecode / build / packaging
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
__pypackages__/

# Python: virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python: tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
cython_debug/

# Python: coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py.cover
cover/

# Python: dependency managers
# NOTE: uv.lock / poetry.lock are intentionally TRACKED (reproducible evaluation).
.pdm-python
.pdm-build/
.pixi/

# Python: notebooks
.ipynb_checkpoints/

# Python: docs
docs/_build/
/site

# ---------------------------------------------------------------------
# Go (server/)
# ---------------------------------------------------------------------
server/bin/
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out
coverage.out
go.work
go.work.sum

# ---------------------------------------------------------------------
# Foundry / Solidity sandbox
# ---------------------------------------------------------------------
out/
cache/
broadcast/
# forge dependencies (lib/ is also covered by the Python rules above);
# restore them with `forge install` in scripts/setup_foundry.sh
lib/
lib64/

# ---------------------------------------------------------------------
# Project runtime artifacts
# ---------------------------------------------------------------------
# CLI reports
reports/*
!reports/.gitkeep

# LLM response cache, traces, local vector store
agent/.cache/
agent/.traces/
agent/.qdrant_data/

# Eval run outputs (versioned results: commit selected ones manually with `git add -f`)
eval/results/*
!eval/results/.gitkeep

# Local databases (server TaskStore SQLite, etc.)
*.sqlite
*.sqlite3
*.db

# Logs & misc caches
*.log
.cache

# ---------------------------------------------------------------------
# Generated code (uncomment if you prefer NOT to commit generated proto code)
# ---------------------------------------------------------------------
# server/gen/**/*.pb.go
# agent/src/audit_agent/server/*_pb2.py
# agent/src/audit_agent/server/*_pb2_grpc.py

# ---------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------
.idea/
.vscode/
tempCodeRunnerFile.py
.spyderproject
.spyproject
.ropeproject
.DS_Store
Thumbs.db