# ---- LLM (OpenAI-compatible) ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat

# ---- Embedding (OpenAI-compatible) ----
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# ---- Budgets ----
MAX_TOKENS_PER_AUDIT=200000
MAX_COST_USD_PER_AUDIT=1.0
AUDIT_TIMEOUT_SECONDS=900

# ---- Qdrant ----
# Phase 1: embedded local mode (path). Phase 2: set QDRANT_URL.
QDRANT_PATH=./agent/.qdrant_data
QDRANT_URL=

# ---- Server (Phase 2) ----
GRPC_AGENT_ADDR=localhost:50051
HTTP_ADDR=:8080
