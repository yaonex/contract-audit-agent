# ---- LLM (OpenAI-compatible) ----
AUDIT_LLM_BASE_URL=https://api.deepseek.com
AUDIT_LLM_API_KEY=
AUDIT_LLM_MODEL=deepseek-chat

# ---- Embedding (OpenAI-compatible) ----
AUDIT_EMBED_BASE_URL=
AUDIT_EMBED_API_KEY=
AUDIT_EMBED_MODEL=

# ---- Budgets ----
AUDIT_MAX_TOTAL_TOKENS=200000
AUDIT_MAX_COST_USD=0.5
AUDIT_TIMEOUT_SECONDS=900

# ---- Qdrant ----
# Phase 1: embedded local mode (path). Phase 2: set QDRANT_URL.
AUDIT_QDRANT_PATH=./agent/.qdrant_data
AUDIT_QDRANT_URL=

# ---- Server (Phase 2) ----
AUDIT_GRPC_AGENT_ADDR=localhost:50051
AUDIT_HTTP_ADDR=:8080
